# Salin berkas ini menjadi .env lalu sesuaikan.

# Alamat backend. Kosongkan atau biarkan kalau starter masih dijalankan
# tanpa backend — panggilan API akan gagal diam-diam dan UI tetap tampil.
VITE_API_URL=http://localhost:8080

# Alamat yang mengalihkan ke Google OAuth; biasanya endpoint backend.
VITE_OAUTH_GOOGLE_URL=/api/v1/auth/google/redirect
